<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Agentic Software Engineering System</title>
<style>
:root{color-scheme:dark;--bg:#0b1020;--panel:#131b2e;--panel2:#19243a;--line:#2a3955;--text:#e9eef9;--muted:#9caecb;--accent:#7cafff;--good:#78d9ad;--warn:#ffd27d;--bad:#ff9c9c}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#172543,var(--bg) 55%);font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif;color:var(--text)}main{max-width:1180px;margin:auto;padding:28px 20px 60px}.eyebrow{color:var(--accent);font-weight:700;letter-spacing:.13em;text-transform:uppercase;font-size:12px}.hero{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin:8px 0 24px}.hero h1{font-size:clamp(28px,4vw,42px);line-height:1.1;margin:8px 0 12px;max-width:760px}.hero p{color:var(--muted);max-width:720px;margin:0}.pill{border:1px solid var(--line);border-radius:99px;padding:7px 12px;color:var(--good);white-space:nowrap}.layout{display:grid;grid-template-columns:minmax(280px, .85fr) minmax(0,1.3fr);gap:18px}.panel{background:rgba(19,27,46,.94);border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 18px 50px #0002}.panel h2{font-size:17px;margin:0 0 15px}.field{display:block;margin:13px 0 7px;color:var(--muted);font-size:13px}textarea,select,input{width:100%;border:1px solid var(--line);background:#0d1527;color:var(--text);padding:12px;border-radius:10px;font:inherit}textarea{min-height:150px;resize:vertical}button{border:0;border-radius:10px;background:var(--accent);color:#081225;font-weight:750;padding:12px 16px;cursor:pointer;font:inherit}button:disabled{opacity:.45;cursor:wait}.primary{width:100%;margin-top:14px}.secondary{background:var(--panel2);border:1px solid var(--line);color:var(--text)}.row{display:flex;gap:10px}.row>*{flex:1}.hint{color:var(--muted);font-size:12px}.status{font-weight:700;color:var(--warn)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}.metric{background:var(--panel2);border-radius:12px;padding:12px}.metric strong{font-size:21px;display:block}.metric span{color:var(--muted);font-size:12px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:15px 0}.tab{padding:8px 12px;background:transparent;border:1px solid var(--line);color:var(--muted)}.tab.active{background:var(--panel2);color:var(--text);border-color:var(--accent)}.task{display:grid;grid-template-columns:42px 1fr auto;gap:12px;align-items:start;padding:12px 0;border-bottom:1px solid var(--line)}.task:last-child{border:0}.num{width:34px;height:34px;border-radius:10px;background:#243657;display:grid;place-items:center;font-weight:700}.task small{display:block;color:var(--muted);margin-top:3px}.state{font-size:11px;text-transform:uppercase;border:1px solid var(--line);border-radius:99px;padding:4px 7px;color:var(--muted)}.state.completed,.state.passed,.state.approved{color:var(--good);border-color:#28644d}.state.failed,.state.rejected,.state.needs_attention{color:var(--bad);border-color:#70414a}.state.awaiting_approval{color:var(--warn);border-color:#705d35}.hidden{display:none!important}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#091020;border:1px solid var(--line);padding:13px;border-radius:10px;max-height:420px;overflow:auto;color:#d5e2fa;font-size:12px}.artifact{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid var(--line)}.artifact a{color:var(--accent);text-decoration:none}.alert{padding:12px;border-radius:10px;background:#342a19;color:var(--warn);margin:10px 0}.success{color:var(--good)}.footer{color:var(--muted);font-size:12px;margin-top:20px}@media(max-width:850px){.layout{grid-template-columns:1fr}.hero{display:block}.pill{display:inline-block;margin-top:16px}.cards{grid-template-columns:repeat(3,1fr)}}
</style></head><body><main>
<div class="eyebrow">Engineering automation · prototype</div><section class="hero"><div><h1>From requirement to reviewable engineering.</h1><p>A dependency-aware multi-agent workflow for architecture, implementation, tests, documentation, risk review and controlled approval. Mock mode runs without API credentials.</p></div><div class="pill">● Human approval required</div></section>
<div class="layout"><section class="panel"><h2>Start an engineering run</h2><label class="field" for="scenario">Example scenario</label><select id="scenario"><option value="greenfield">Greenfield · URL shortener (mandatory)</option><option value="brownfield">Brownfield · payment idempotency</option><option value="ambiguous">Ambiguous · faster and more reliable</option><option value="auto">Auto-detect scenario</option></select><label class="field" for="requirement">Software requirement</label><textarea id="requirement">Build a scalable URL shortener service with APIs, persistence, and analytics.</textarea><label class="field" for="repo">Repository context (for brownfield analysis)</label><textarea id="repo" style="min-height:90px" placeholder="Paste relevant modules, APIs, tests, and data flows. Avoid secrets."></textarea><div class="row"><div><label class="field" for="mode">Agent mode</label><select id="mode"><option value="mock">Mock · deterministic</option><option value="remote">Remote · OpenAI-compatible API</option></select></div><div><label class="field" for="reviewer">Reviewer (for approval)</label><input id="reviewer" value="engineering-reviewer"></div></div><button class="primary" id="runBtn" onclick="startRun()">Run engineering workflow →</button><p class="hint">Generated code is not automatically executed or deployed. Review before merging.</p></section>
<section class="panel"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center"><h2>Workflow result</h2><span id="status" class="status">Ready</span></div><div class="cards"><div class="metric"><strong id="taskCount">—</strong><span>Tasks</span></div><div class="metric"><strong id="artifactCount">—</strong><span>Artifacts</span></div><div class="metric"><strong id="validation">—</strong><span>Validation</span></div></div><div id="empty"><p class="hint">Choose a scenario and start a run. You’ll see the task graph results, validation evidence, artifacts, trace, assumptions and approval gate here.</p></div><div id="result" class="hidden"><div class="tabs"><button class="tab active" data-tab="tasks" onclick="showTab('tasks',this)">Tasks</button><button class="tab" data-tab="artifacts" onclick="showTab('artifacts',this)">Artifacts</button><button class="tab" data-tab="validation" onclick="showTab('validation',this)">Validation</button><button class="tab" data-tab="trace" onclick="showTab('trace',this)">Trace</button><button class="tab" data-tab="review" onclick="showTab('review',this)">Review</button></div><div id="tab-tasks"></div><div id="tab-artifacts" class="hidden"></div><div id="tab-validation" class="hidden"></div><div id="tab-trace" class="hidden"></div><div id="tab-review" class="hidden"></div></div></section></div><div class="footer">ASES prototype · in-memory run state · artifacts stored locally · no automatic deployment</div></main>
<script>
let currentRun=null;const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const presets={greenfield:{requirement:'Build a scalable URL shortener service with APIs, persistence, and analytics.',repo:''},brownfield:{requirement:'Add idempotency to the payment submission endpoint and improve its integration tests.',repo:'Illustrative repository: payments/api.py exposes POST /payments; services/payment_service.py creates payment records; repositories/payment_repository.py persists them; tests/test_payments.py covers basic success only. Client retries may create duplicate payment records.'},ambiguous:{requirement:'Make the service faster and more reliable.',repo:''}};
$('scenario').addEventListener('change',()=>{const v=$('scenario').value;if(presets[v]){$('requirement').value=presets[v].requirement;$('repo').value=presets[v].repo}});
async function startRun(){const btn=$('runBtn');btn.disabled=true;btn.textContent='Running workflow…';$('status').textContent='Executing';try{const res=await fetch('/api/runs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({requirement:$('requirement').value,scenario:$('scenario').value,mode:$('mode').value,repository_context:$('repo').value})});const data=await res.json();if(!res.ok)throw new Error(data.detail||'Workflow failed');currentRun=data;render(data)}catch(e){$('status').textContent='Error';$('empty').innerHTML='<div class="alert">'+esc(e.message)+'</div>'}finally{btn.disabled=false;btn.textContent='Run engineering workflow →'}}
function showTab(name,button){['tasks','artifacts','validation','trace','review'].forEach(t=>$('tab-'+t).classList.toggle('hidden',t!==name));document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b===button))}
function render(d){$('empty').classList.add('hidden');$('result').classList.remove('hidden');$('status').textContent=d.status.replaceAll('_',' ');$('taskCount').textContent=d.tasks.length;$('artifactCount').textContent=d.artifacts.length;$('validation').textContent=d.validation?.status||'—';$('tab-tasks').innerHTML=d.tasks.map((t,i)=>`<div class="task"><div class="num">${esc(t.id)}</div><div><b>${esc(t.name)}</b><small>Agent: ${esc(t.agent)} · Depends on: ${esc(t.depends_on.join(', ')||'none')}</small>${t.output?.summary?`<small>${esc(t.output.summary)}</small>`:''}${t.output?.impacted_components?`<small>Impacted: ${esc(t.output.impacted_components.join(', '))}</small>`:''}</div><span class="state ${esc(t.status)}">${esc(t.status)}</span></div>`).join('');$('tab-artifacts').innerHTML=d.artifacts.map(a=>`<div class="artifact"><span>${esc(a)}</span><a href="/api/runs/${encodeURIComponent(d.run_id)}/artifacts/${a.split('/').map(encodeURIComponent).join('/')}" target="_blank">Open ↗</a></div>`).join('')+`<p class="hint">Run ID: ${esc(d.run_id)} · artifacts are written to ${esc(d.artifacts_dir)}</p>`;
$('tab-validation').innerHTML=`<h3>Artifact checks: <span class="${d.validation?.status==='passed'?'success':''}">${esc(d.validation?.status||'not available')}</span></h3><pre>${esc(JSON.stringify({artifact_validation:d.validation,reference_tests:d.test_result},null,2))}</pre>`;
$('tab-trace').innerHTML=`<p class="hint">Trace shows parallel task layers, task transitions, artifact generation and validation.</p><pre>${esc(JSON.stringify(d.trace,null,2))}</pre>`;
$('tab-review').innerHTML=`<h3>Assumptions</h3><ul>${(d.normalized_requirement.assumptions||[]).map(x=>'<li>'+esc(x)+'</li>').join('')}</ul><h3>Open questions / ambiguities</h3>${d.review_questions.length?'<ul>'+d.review_questions.map(x=>'<li>'+esc(x)+'</li>').join('')+'</ul>':'<p>No obvious ambiguities detected by the initial heuristic scan.</p>'}<h3>Human approval gate</h3><p>Current decision: <b>${esc(d.approval.status)}</b>. Approval records a review decision only; it does not deploy code.</p><label class="field">Review comment</label><textarea id="comment" style="min-height:75px" placeholder="What did you review? What remains to be done?"></textarea><div class="row" style="margin-top:10px"><button onclick="approve(true)">Approve outcome</button><button class="secondary" onclick="approve(false)">Reject outcome</button></div><p class="hint" id="approvalMessage"></p>`;
showTab('tasks',document.querySelector('[data-tab="tasks"]'))}
async function approve(approved){if(!currentRun)return;try{const r=await fetch(`/api/runs/${encodeURIComponent(currentRun.run_id)}/approve`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({approved,reviewer:$('reviewer').value,comment:$('comment')?.value||''})});const d=await r.json();if(!r.ok)throw new Error(d.detail||'Approval failed');currentRun=d;$('status').textContent=d.status.replaceAll('_',' ');$('approvalMessage').textContent='Decision recorded: '+d.approval.status;render(d);showTab('review',document.querySelector('[data-tab="review"]'))}catch(e){$('approvalMessage').textContent=e.message}}
</script></body></html>
